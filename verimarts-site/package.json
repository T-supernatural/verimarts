{
  "name": "fashyn-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "dev:portal": "vite --mode portal --host 127.0.0.1 --port 5174",
    "build:portal": "tsc --noEmit && vite build --mode portal --outDir dist-portal",
    "build:host": "node scripts/build-host.mjs",
    "test:security": "node scripts/test-security.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
